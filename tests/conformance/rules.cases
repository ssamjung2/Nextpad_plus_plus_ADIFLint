# ADIF Lint conformance cases: for every rule in src/core/adif_rules.cpp and each file format it
# applies to, a case that breaks it and one that keeps it. tests/conformance_tests.cpp says how a
# line is read; in short:
#
#   CODE  FORMATS  VERSION  EXPECT  INPUT
#
# FORMATS adi, adx or both. VERSION "-" (the newest), an ADIF version, or "file" (the file's own).
# EXPECT error, warning or note (one finding of CODE), error*2..., or clean (none of CODE).
# INPUT [HEADER ||] RECORD [| RECORD]: <NAME>value or <NAME:T>value, lengths filled in; each record
# gets QSO_DATE 20240115, TIME_ON 1830, CALL WF1B, BAND 20m and MODE CW unless it names them or
# starts with "bare". Or raw:TEXT, the whole file. Escapes: \n \r \t \s \| \< \\ \xHH.
# "Today" is 2026-11-01.

# ── ADI structure (§IV.A) ──
tag-syntax        adi   -  error    raw:log\n<EOH>\n<QSO_DATE:8>20240115 <CALL:4W1AW <EOR>\n
tag-syntax        adi   -  warning  raw:log\n<EOH>\n<QSO_DATE:8>20240115 <CALL:4>W1AW < <EOR>\n
tag-syntax        adi   -  clean    <CALL>W1AW
length            adi   -  error    raw:log\n<EOH>\n<QSO_DATE:8>20240115 <CALL:3>W1AW<BAND:3>20m<EOR>\n
length            adi   -  error    raw:log\n<EOH>\n<QSO_DATE:8>20240115 <CALL:5>W1AW\n<EOR>\n
length            adi   -  clean    <CALL>W1AW
length-zeros      adi   -  warning  raw:log\n<EOH>\n<QSO_DATE:8>20240115 <CALL:04>W1AW <EOR>\n
length-zeros      adi   -  clean    <CALL>W1AW
length-swallows   adi   -  warning  raw:log\n<EOH>\n<QSO_DATE:8>20240115 <NAME:16>Bob <BAND:3>20m <EOR>\n
length-swallows   adi   -  clean    <NAME>Bob
missing-lt        adi   -  warning  raw:log\n<EOH>\n<CALL:4>W1AW <EOR>\nBAND:3>20m\n<CALL:4>K1AB <EOR>\n
missing-lt        adi   -  clean    <CALL>W1AW
bom               adi   -  warning  raw:\xEF\xBB\xBFlog\n<EOH>\n<CALL:4>W1AW <EOR>\n
bom               adi   -  clean    <CALL>W1AW
eoh-missing       adi   -  error    raw:log\n<ADIF_VER:5>3.1.8\n
eoh-missing       adi   -  warning  raw:log\n<CALL:4>W1AW <EOR>\n
eoh-missing       adi   -  note     raw:\s\n<CALL:4>W1AW <EOR>\n
eoh-missing       adi   -  clean    <CALL>W1AW
eoh-no-header     adi   -  warning  raw:<ADIF_VER:5>3.1.8 <EOH>\n<CALL:4>W1AW <EOR>\n
eoh-no-header     adi   -  clean    raw:<CALL:4>W1AW <EOR>\n
eoh-twice         adi   -  error    raw:log\n<EOH>\n<EOH>\n<CALL:4>W1AW <EOR>\n
eoh-twice         adi   -  clean    <CALL>W1AW
eoh-late          adi   -  error    raw:<CALL:4>W1AW <EOR>\n<EOH>\n
eoh-late          adi   -  clean    <CALL>W1AW
no-eor            adi   -  error    raw:log\n<EOH>\n<CALL:4>W1AW\n
no-eor            adi   -  clean    <CALL>W1AW
empty-record      both  -  warning  bare
empty-record      both  -  clean    <CALL>W1AW
no-records        adi   -  note     raw:log\n<ADIF_VER:5>3.1.8\n<EOH>\n
no-records        adi   -  clean    <CALL>W1AW

# ── ADX structure (§IV.B, §IV.B.1) ──
xml               adx   -  error    raw:<?xml version="1.0"?>\n<ADX><HEADER/><RECORDS><RECORD><CALL>W1AW</RECORD></RECORDS></ADX>\n
xml               adx   -  error    raw:<?xml version="1.0"?>\n<ADX><HEADER/><RECORDS><RECORD><CALL>&W1AW;</CALL></RECORD></RECORDS></ADX>\n
xml               adx   -  clean    <CALL>W1AW
adx-encoding      adx   -  error    raw:<?xml version="1.0" encoding="ISO-8859-1"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS/></ADX>\n
adx-encoding      adx   -  clean    raw:<?xml version="1.0" encoding="utf-8"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS/></ADX>\n
adx-doctype       adx   -  error    raw:<?xml version="1.0"?>\n<!DOCTYPE ADX>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS/></ADX>\n
adx-doctype       adx   -  clean    <CALL>W1AW
adx-entity        adx   -  error    raw:<?xml version="1.0"?>\n<!DOCTYPE ADX [<!ENTITY tb "160m">]>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS><RECORD><CALL>W1AW</CALL><BAND>&tb;</BAND></RECORD></RECORDS></ADX>\n
adx-entity        adx   -  clean    <COMMENT>Bob & Alice \<rig>
adx-cdata         adx   -  error    raw:<?xml version="1.0"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS><RECORD><CALL>W1AW</CALL><COMMENT><![CDATA[a < b]]></COMMENT></RECORD></RECORDS></ADX>\n
adx-cdata         adx   -  clean    raw:<?xml version="1.0"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS><RECORD><CALL>W1AW</CALL><![CDATA[ a note between fields ]]></RECORD></RECORDS></ADX>\n

# ── Header (§III.C.1.a) ──
adif-ver          both  -  warning  <ADIF_VER>3.1 || <CALL>W1AW
adif-ver          both  -  clean    <ADIF_VER>3.1.8 || <CALL>W1AW
created-timestamp both  -  error    <ADIF_VER>3.1.8 <CREATED_TIMESTAMP>20240115 250000 || <CALL>W1AW
created-timestamp both  -  clean    <ADIF_VER>3.1.8 <CREATED_TIMESTAMP>20240115 120000 || <CALL>W1AW

# ── Fields (§III.C) ──
unknown-field     both  -  warning  <FOO>bar
unknown-field     both  -  warning  <ADIF_VER>3.1.8 <FOO>bar || <CALL>W1AW
unknown-field     both  -  clean    <NAME>Bob
field-version     both  3.1.3  warning  <POTA_REF>K-0001
field-version     both  3.1.4  clean    <POTA_REF>K-0001
field-place       both  -  warning  <PROGRAMID>MonoLog
field-place       both  -  clean    <ADIF_VER>3.1.8 <PROGRAMID>MonoLog || <CALL>W1AW
dup-field         both  -  error    <NAME>Bob <NAME>Robert
dup-field         both  -  error    <ADIF_VER>3.1.8 <PROGRAMID>A <PROGRAMID>B || <CALL>W1AW
dup-field         both  -  clean    <NAME>Bob
import-only       both  -  warning  <VE_PROV>ON
import-only       both  -  warning  <QSL_RCVD>V
import-only       both  -  clean    <MODE>DIGITALVOICE <SUBMODE>C4FM
intl-adi          adi   -  error    <NAME_INTL>Jos\xC3\xA9
intl-adi          adi   -  note     <ADIF_VER>3.1.8 <USERDEF1:I>NOTE || <CALL>W1AW
intl-adi          adi   -  clean    <NAME>Jose
indicator         both  -  error    <APP_MONOLOG_SPEED:Q>18
indicator         adi   -  warning  <CALL:N>W1AW
indicator         both  -  clean    <APP_MONOLOG_SPEED:N>18

