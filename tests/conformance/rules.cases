intl-line-break   adx   -  error    <ADIF_VER>3.1.8 <USERDEF1:I>NOTE_I || <NOTE_I>two\nlines
intl-line-break   adx   -  clean    <ADIF_VER>3.1.8 <USERDEF1:I>NOTE_I || <NOTE_I>Alen\xC3\xA7on

# ── Enumerations (§III.B, §II.B, §II.C) ──
enumeration       both  -  error    <BAND>21m
