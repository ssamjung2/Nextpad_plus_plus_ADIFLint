userdef-value     both  -  clean    <ADIF_VER>3.1.8 <USERDEF1:E>SIZE,{S,M,L} || <SIZE>m
userdef-enum-range adx  -  error    raw:<?xml version="1.0"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER><USERDEF FIELDID="1" TYPE="E" ENUM="{S,M,L}" RANGE="{1:5}">SIZE</USERDEF></HEADER><RECORDS/></ADX>\n
userdef-enum-range adx  -  clean    <ADIF_VER>3.1.8 <USERDEF1:E>SIZE,{S,M,L} || <SIZE>M

# ── Application-defined fields (§IV.A.4, §IV.B.2) ──
app-name          both  -  warning  <APP_MONOLOG>1
app-name          adx   -  warning  raw:<?xml version="1.0"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER></HEADER><RECORDS><RECORD><CALL>W1AW</CALL><APP PROGRAMID="My:Log" FIELDNAME="X">1</APP></RECORD></RECORDS></ADX>\n
app-name          both  -  clean    <APP_MONOLOG_COMPRESSION>off
app-type          both  -  error    <APP_MONOLOG_NEXT:N>1 | <APP_MONOLOG_NEXT:D>20240101
app-type          both  -  clean    <APP_MONOLOG_NEXT:N>1 | <APP_MONOLOG_NEXT:N>2

# ── ADX schemas (§IV.B.5, §V.A) ──
schema            adx   -  error    <BAND>21m
schema            adx   -  error    <AGE>121
schema            adx   3.1.0  error  <POTA_REF>K-0001
schema            adx   -  clean    <AGE>120
schema-export     adx   -  warning  <VE_PROV>ON
schema-export     adx   -  warning  <ANT_AZ>370
schema-export     adx   -  clean    <ANT_AZ>360
schema-strict     adx   -  warning  <ADIF_VER>3.1.8 <USERDEF1:E>SIZE,{S,M,L} || <Size>M
schema-strict     adx   -  warning  raw:<?xml version="1.0"?>\n<ADX><HEADER><ADIF_VER>3.1.8</ADIF_VER><USERDEF FIELDID="1" TYPE="S">NOTE</USERDEF></HEADER><RECORDS><RECORD><CALL>W1AW</CALL><USERDEF FIELDNAME="NOTE" TYPE="S">x</USERDEF></RECORD></RECORDS></ADX>\n
schema-strict     adx   -  clean    <ADIF_VER>3.1.8 <USERDEF1:E>SIZE,{S,M,L} || <SIZE>M
schema-version    adx   3.0.2  note   <NAME>Bob
schema-version    adx   3.0.3  clean  <NAME>Bob

# ── Versions ──
