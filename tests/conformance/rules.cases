grid-ext-length   both  -  clean    <GRIDSQUARE>FN31pr45 <GRIDSQUARE_EXT>ab
grid-ext-base     both  -  warning  <GRIDSQUARE>FN31 <GRIDSQUARE_EXT>ab
grid-ext-base     both  -  clean    <GRIDSQUARE>FN31pr45 <GRIDSQUARE_EXT>ab
lat-lon           both  -  error    <LAT>W074 00.000
