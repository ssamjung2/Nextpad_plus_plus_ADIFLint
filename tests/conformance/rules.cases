type-iota         both  -  clean    <IOTA>NA-001
type-pota         both  -  error    <POTA_REF>K-12
type-pota         both  -  clean    <POTA_REF>K-0001,VE-5082@CA-AB
type-sota         both  -  warning  <SOTA_REF>W2/WE-0003
type-sota         both  -  warning  <SOTA_REF>W2WE003
type-sota         both  -  clean    <SOTA_REF>W2/WE-003
type-wwff         both  -  error    <WWFF_REF>KFF-1
type-wwff         both  -  clean    <WWFF_REF>KFF-4655
